{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
      "dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
      "dependsOn": ["@repo/main-api#build"],
			"persistent": true,
			"cache": false
		},
    "format": {
      "dependsOn": ["^format"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
	}
}
